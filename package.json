{
  "name": "ceulen",
  "version": "0.5.0",
  "description": "Ceulen — the Pi coding agent, fully dressed: one bundle extension carrying the full toolkit with a single /ceulen config command.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "coding-agent",
    "agent-harness",
    "ai",
    "cli"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "extensions",
    "skills",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceulen-dev/ceulen.git"
  },
  "homepage": "https://github.com/ceulen-dev/ceulen#readme",
  "bugs": "https://github.com/ceulen-dev/ceulen/issues",
  "scripts": {
    "test": "node --import tsx --test extensions/modules/router/test/unit.test.ts extensions/modules/router/test/guard.test.ts extensions/modules/usage/test/*.test.ts extensions/modules/ponytail/test/*.test.ts extensions/modules/config/test/*.test.ts extensions/modules/composer/test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.1",
    "@earendil-works/pi-tui": "^0.99.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
